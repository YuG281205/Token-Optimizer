{
    "manifest_version": 3,

    "name": "SGP Token Optimizer",

    "version": "1.0.0",

    "description": "Optimize ChatGPT prompts and reduce token usage.",

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "background": {
        "service_worker": "background.js"
    }
}