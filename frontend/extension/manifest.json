{
    "manifest_version": 3,

    "name": "SGP Token Optimizer",

    "version": "1.0.0",

    "description": "Optimize ChatGPT prompts and reduce token usage.",

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "https://token-optimizer-nsi6.onrender.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
    ],

    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "background": {
        "service_worker": "background.js"
    }
}